{
  "name": "@manoj-malviya-96/csworld",
  "version": "0.1.0",
  "description": "Local web viewer for browsing your Claude Code session transcripts",
  "type": "module",
  "bin": {
    "csworld": "dist/server/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "npm run build && node dist/server/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manoj-malviya-96/heavy-coders.git",
    "directory": "claude-world"
  },
  "publishConfig": {
    "access": "public"
  }
}
